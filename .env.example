# ─── Google Gemini ───
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ─── 登入密碼（必填）───
# 服務會透過 Cloudflare Tunnel 公開在網際網路上，沒有設定密碼會拒絕啟動。
# 至少 12 個字元。
AUTH_PASSWORD=change_me_to_a_long_passphrase

# 若不想在 .env 放明文密碼，改用雜湊（設了這個就會忽略 AUTH_PASSWORD）：
#   python3 -c "from werkzeug.security import generate_password_hash as g; print(g(input()))"
# AUTH_PASSWORD_HASH=scrypt:32768:8:1$...

# ─── Session ───
# 一台裝置登入後可以維持多久（沒有任何操作才會過期，有用就會自動延長）
SESSION_DAYS=180
# 把數字加 1 可以強制所有裝置重新登入（例如密碼外流時）
AUTH_SESSION_VERSION=1
# 正式環境（Cloudflare HTTPS）必須是 true；只在本機用 http 測試時才設成 false
COOKIE_SECURE=true

# 只影響 `python app.py` 開發伺服器；正式服務固定跑在 127.0.0.1:8000
PORT=7001

# ─── Flask ───
# 建議不要設定：會自動產生 64 字元金鑰並存到 .secret_key（重啟不會把大家登出）
# 若要自己設，至少 32 字元，否則服務拒絕啟動
# SECRET_KEY=
